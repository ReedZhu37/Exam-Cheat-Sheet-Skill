{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://exam-cheat-sheet.local/schemas/manifest.schema.json",
  "title": "Material acquisition manifest",
  "type": "object",
  "required": ["schema_version", "sources"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "sources": {"type": "array", "items": {"$ref": "#/$defs/source"}}
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "page": {
      "type": "object",
      "required": ["page_number", "anchor", "text", "text_sha256", "page_sha256", "raster_path", "quality", "review_reasons", "duplicate_of"],
      "properties": {
        "page_number": {"type": "integer", "minimum": 1},
        "anchor": {"type": "string", "minLength": 1},
        "text": {"type": "string"},
        "text_sha256": {"$ref": "#/$defs/sha256"},
        "page_sha256": {"$ref": "#/$defs/sha256"},
        "raster_path": {"type": ["string", "null"]},
        "quality": {"enum": ["extracted", "needs_review"]},
        "review_reasons": {"type": "array", "items": {"type": "string"}},
        "duplicate_of": {"type": ["integer", "null"], "minimum": 1},
        "blocks": {"type": "array", "items": {"type": "object"}}
      },
      "additionalProperties": false
    },
    "metadata": {
      "type": "object",
      "required": ["sha256", "size_bytes", "parser", "page_count", "page_unit", "pages"],
      "properties": {
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 0},
        "parser": {
          "type": "object", "required": ["name", "version"],
          "properties": {"name": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}},
          "additionalProperties": false
        },
        "page_count": {"type": "integer", "minimum": 1},
        "page_unit": {"enum": ["pdf_page", "slide", "document"]},
        "pages": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/page"}}
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": ["id", "path", "role", "split", "status", "provenance", "metadata"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "role": {"enum": ["textbook", "slides", "notes", "past_exam", "solution", "scope"]},
        "split": {"enum": ["train", "dev", "sealed_test"]},
        "status": {"enum": ["pending", "acquired", "validated", "failed"]},
        "provenance": {
          "type": "object",
          "required": ["origin", "license", "acquired_at"],
          "properties": {
            "origin": {"type": "string", "minLength": 1},
            "license": {"type": "string", "minLength": 1},
            "acquired_at": {"type": ["string", "null"], "format": "date-time"},
            "citation": {"type": ["string", "null"]},
            "notes": {"type": "string"}
          },
          "additionalProperties": false
        },
        "metadata": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/metadata"}]}
      },
      "allOf": [
        {"if": {"properties": {"status": {"enum": ["acquired", "validated"]}}}, "then": {
          "properties": {"metadata": {"$ref": "#/$defs/metadata"}, "provenance": {"properties": {"acquired_at": {"type": "string", "format": "date-time"}}}}
        }},
        {"if": {"properties": {"status": {"const": "pending"}}}, "then": {"properties": {"metadata": {"type": "null"}}}}
      ],
      "additionalProperties": false
    }
  }
}
